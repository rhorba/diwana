# Diwana.ma — environment variables
# Copy to .env.local and fill in. NEVER commit .env or .env.local.
# Source of truth: docs/devops-diwana.md section 5

# --- Database (Sprint 1) ---
DATABASE_URL=
DIRECT_URL=

# --- Auth: Clerk (Sprint 1) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Tariff ingestion cron (Sprint 2) ---
CRON_SECRET=

# --- AI classification (Sprint 4) ---
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-sonnet-5

# --- Cache + rate limiting (Sprint 4) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring (Sprint 6) ---
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Billing (Sprint 6) ---
CMI_MERCHANT_ID=
CMI_STORE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
